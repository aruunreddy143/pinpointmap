# Copy to .env for local development. Never commit real secrets.
PINPOINT_DATABASE_URL=postgresql+psycopg://pinpoint:pinpoint_dev_only@localhost:5432/pinpoint
PINPOINT_TEST_DATABASE_URL=postgresql+psycopg://pinpoint:pinpoint_dev_only@localhost:5432/pinpoint_test
# Must be a long random value in every real environment.
PINPOINT_SECRET_KEY=dev-only-change-me-this-is-not-a-secret
PINPOINT_ENVIRONMENT=development
PINPOINT_PUBLIC_BASE_URL=http://localhost:5173
PINPOINT_CORS_ORIGINS=["http://localhost:5173"]
